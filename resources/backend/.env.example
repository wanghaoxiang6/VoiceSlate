VOICE_SLATE_BACKEND_HOST=127.0.0.1
VOICE_SLATE_BACKEND_PORT=8788
VOICE_SLATE_BACKEND_URL=http://127.0.0.1:8788
VOICE_SLATE_BACKEND_DATA_DIR=./backend-data
BETTER_AUTH_SECRET=replace-this-with-a-long-random-secret

# Optional OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional billing
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=

# Optional managed LLM proxy
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=

# Optional managed STT proxy. Use an OpenAI-compatible transcription endpoint
# such as https://api.openai.com/v1 with /audio/transcriptions.
CLOUD_STT_BASE_URL=
CLOUD_STT_TRANSCRIPTION_PATH=/audio/transcriptions
CLOUD_STT_API_KEY=
